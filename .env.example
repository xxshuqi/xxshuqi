# This site needs no environment variables to build or deploy.
#
# The only one the code reads is NEXT_PUBLIC_BASE_PATH, used by
# src/lib/imageLoader.ts to prefix image paths when the site is served from a
# subdirectory. It is empty for thewanderingbunny.com, which is served from the
# root, so there is nothing to set.
#
# NEXT_PUBLIC_BASE_PATH=

# Removed: DATABASE_URL, ADMIN_PASSWORD, JWT_SECRET, NEXT_PUBLIC_SITE_URL and
# the S3_* block. They date from a Prisma/admin-panel version of this project
# that no longer exists, and nothing read them.
